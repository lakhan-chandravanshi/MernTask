{
  "name": "merntask",
  "version": "1.0.0",
  "description": "Secure and scalable Node.js authentication system using Express, TypeScript, Prisma, PostgreSQL, Redis, JWT and BullMQ",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "ts-node-dev --respawn --transpile-only src/queues/email.worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma generate || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakhan-chandravanshi/MernTask.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "authentication",
    "jwt",
    "redis",
    "prisma",
    "postgresql",
    "bullmq",
    "multer"
  ],
  "author": "Lakhan Chandravanshi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lakhan-chandravanshi/MernTask/issues"
  },
  "homepage": "https://github.com/lakhan-chandravanshi/MernTask#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}